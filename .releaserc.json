{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "bash scripts/build-release-assets.sh ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/*.deb",
            "label": "Stowmark Observability Debian package"
          },
          {
            "path": "dist/stowmark-observability-*.tgz",
            "label": "Stowmark Observability Helm chart"
          }
        ]
      }
    ]
  ]
}
