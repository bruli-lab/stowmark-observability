BIND_ADDRESS=127.0.0.1
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# The package generates a random initial password in
# /var/lib/stowmark-observability/grafana.env. Set it here to override it.
# Grafana only reads it when it initialises its data volume.
#GRAFANA_ADMIN_PASSWORD=
GRAFANA_ANONYMOUS_ENABLED=false
PROMETHEUS_RETENTION=15d
